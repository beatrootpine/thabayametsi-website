---
// Styled static map: the reserve between Mookgopong and Mokopane, with a Johannesburg inset.
// Plain SVG, no map tiles, no Google branding. Positions are projected from real coordinates.
import { SITE } from '../data/site';
const W = 1000;
const LON0 = 28.15, LON1 = 29.65, LAT0 = -23.72, LAT1 = -25.02;
const k = Math.cos((24.4 * Math.PI) / 180);
const H = Math.round((W * (LAT0 - LAT1)) / ((LON1 - LON0) * k));
const P = (lat: number, lon: number) => [((lon - LON0) / (LON1 - LON0)) * W, ((LAT0 - lat) / (LAT0 - LAT1)) * H];
const pt = (lat: number, lon: number) => P(lat, lon).map((n) => n.toFixed(1)).join(',');
const towns = [
  { n: 'Polokwane', lat: -23.904, lon: 29.468, dx: -14, dy: -14, a: 'end' },
  { n: 'Mokopane', lat: -24.194, lon: 29.01, dx: 14, dy: 5, a: 'start' },
  { n: 'Mookgopong', lat: -24.509, lon: 28.713, dx: 14, dy: 18, a: 'start' },
  { n: 'Modimolle', lat: -24.7, lon: 28.406, dx: 14, dy: 5, a: 'start' },
  { n: 'Bela-Bela', lat: -24.884, lon: 28.293, dx: 14, dy: 5, a: 'start' },
];
const n1 = [[-25.02, 28.24], [-24.884, 28.31], [-24.7, 28.43], [-24.509, 28.735], [-24.36, 28.9], [-24.194, 29.03], [-24.05, 29.25], [-23.904, 29.468], [-23.72, 29.55]];
const r101 = [[-24.7, 28.406], [-24.509, 28.713], [-24.42, 28.79], [-24.355, 28.849], [-24.28, 28.93], [-24.194, 29.01]];
const [rx, ry] = P(SITE.lat, SITE.lng);
const kmPerDeg = 111.32 * k;
const km20 = (20 / kmPerDeg / (LON1 - LON0)) * W;
// Waterberg massif contours (stylised rings to the north-west)
const ring = (cx: number, cy: number, r: number, wob: number, seed: number) => {
  const pts: string[] = [];
  for (let i = 0; i <= 48; i++) {
    const t = (i / 48) * Math.PI * 2;
    const rr = r * (1 + wob * Math.sin(3 * t + seed) + wob * 0.6 * Math.cos(5 * t + seed * 2));
    pts.push(`${(cx + rr * 1.25 * Math.cos(t)).toFixed(1)},${(cy + rr * 0.85 * Math.sin(t)).toFixed(1)}`);
  }
  return 'M' + pts.join('L') + 'Z';
};
const [wx, wy] = P(-24.05, 28.42);
// inset: Johannesburg to Polokwane
const I = { x: 690, y: H - 330, w: 280, h: 300 };
const IL0 = 27.75, IL1 = 29.75, IA0 = -23.6, IA1 = -26.45;
const IP = (lat: number, lon: number) => [I.x + ((lon - IL0) / (IL1 - IL0)) * I.w, I.y + ((IA0 - lat) / (IA0 - IA1)) * I.h];
const ipt = (lat: number, lon: number) => IP(lat, lon).map((n) => n.toFixed(1)).join(',');
const [bx0, by0] = IP(LAT0, LON0), [bx1, by1] = IP(LAT1, LON1);
const iTowns = [{ n: 'Johannesburg', lat: -26.204, lon: 28.047 }, { n: 'Pretoria', lat: -25.747, lon: 28.188 }, { n: 'Polokwane', lat: -23.904, lon: 29.468 }];
---
<figure class="map-figure">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="map-title map-desc">
    <title id="map-title">Map: where Thaba Ya Metsi Private Game Reserve lies</title>
    <desc id="map-desc">The reserve lies on the southern edge of the Waterberg, beside the N1 between Mookgopong and Mokopane in Limpopo, about an hour south of Polokwane and 250 km north of Johannesburg.</desc>
    <rect width={W} height={H} fill="#ece8df" />
    <g fill="none" stroke="#b9ad94" stroke-width="1">
      {[150, 125, 100, 76, 54, 34].map((r, i) => <path d={ring(wx, wy, r, 0.09 + i * 0.012, i * 0.7)} opacity={0.35 + i * 0.1} />)}
    </g>
    <text x={wx} y={wy + 12} text-anchor="middle" font-family="Cormorant Garamond, Georgia, serif" font-style="italic" font-size="38" fill="#7d715b" letter-spacing="5" stroke="#ece8df" stroke-width="6" paint-order="stroke">Waterberg</text>
    <text x={P(-24.62, 29.28)[0]} y={P(-24.62, 29.28)[1]} font-family="Source Sans 3, sans-serif" font-weight="600" font-size="13" fill="#9a8f7a" letter-spacing="5" text-anchor="middle">SPRINGBOK FLATS</text>
    <polyline points={n1.map(([a, b]) => pt(a, b)).join(' ')} fill="none" stroke="#fbfaf7" stroke-width="7" stroke-linejoin="round" />
    <polyline points={n1.map(([a, b]) => pt(a, b)).join(' ')} fill="none" stroke="#3d4a48" stroke-width="2.4" stroke-linejoin="round" />
    <polyline points={r101.map(([a, b]) => pt(a, b)).join(' ')} fill="none" stroke="#3d4a48" stroke-width="1.2" stroke-dasharray="5 4" />
    <g font-family="Source Sans 3, sans-serif" font-weight="600" font-size="12" fill="#fbfaf7">
      <rect x={P(-24.8, 28.36)[0] - 16} y={P(-24.8, 28.36)[1] - 10} width="32" height="20" fill="#3d4a48" />
      <text x={P(-24.8, 28.36)[0]} y={P(-24.8, 28.36)[1] + 4} text-anchor="middle">N1</text>
    </g>
    <text x={P(-24.44, 28.77)[0] + 10} y={P(-24.44, 28.77)[1] + 26} font-family="Source Sans 3, sans-serif" font-size="12" fill="#5c625e" letter-spacing="1">R101</text>
    {towns.map((t) => { const [x, y] = P(t.lat, t.lon); return (
      <g>
        <circle cx={x} cy={y} r="5" fill="#ece8df" stroke="#1b1d1c" stroke-width="1.5" />
        <text x={x + t.dx} y={y + t.dy} text-anchor={t.a} font-family="Source Sans 3, sans-serif" font-weight="600" font-size="15" fill="#1b1d1c" letter-spacing="1.5">{t.n.toUpperCase()}</text>
      </g>); })}
    <g>
      <circle cx={rx} cy={ry} r="26" fill="#8a5d33" opacity="0.14" />
      <circle cx={rx} cy={ry} r="14" fill="none" stroke="#8a5d33" stroke-width="1.2" />
      <rect x={rx - 6} y={ry - 6} width="12" height="12" fill="#8a5d33" transform={`rotate(45 ${rx} ${ry})`} />
      <line x1={rx - 30} y1={ry} x2={rx - 110} y2={ry - 70} stroke="#8a5d33" stroke-width="1" />
      <text x={rx - 116} y={ry - 98} text-anchor="end" font-family="Cormorant Garamond, Georgia, serif" font-size="30" fill="#1b1d1c">Thaba Ya Metsi</text>
      <text x={rx - 116} y={ry - 74} text-anchor="end" font-family="Source Sans 3, sans-serif" font-weight="600" font-size="11.5" fill="#8a5d33" letter-spacing="2">{SITE.gps}</text>
    </g>
    <g transform={`translate(40 ${H - 60})`} font-family="Source Sans 3, sans-serif" font-size="11" fill="#5c625e" letter-spacing="1.5">
      <line x1="0" y1="0" x2={km20} y2="0" stroke="#1b1d1c" stroke-width="1.5" />
      <line x1="0" y1="-5" x2="0" y2="5" stroke="#1b1d1c" stroke-width="1.5" />
      <line x1={km20} y1="-5" x2={km20} y2="5" stroke="#1b1d1c" stroke-width="1.5" />
      <text x="0" y="22">0</text><text x={km20} y="22" text-anchor="middle">20 KM</text>
    </g>
    <g transform={`translate(${40 + km20 + 60} ${H - 64})`} font-family="Source Sans 3, sans-serif" font-weight="600" font-size="12" fill="#1b1d1c">
      <path d="M0 -26 L8 4 L0 -2 L-8 4 Z" fill="#1b1d1c" />
      <text y="24" text-anchor="middle" letter-spacing="2">N</text>
    </g>
    <g>
      <rect x={I.x} y={I.y} width={I.w} height={I.h} fill="#f6f4ee" stroke="#b9ad94" />
      <rect x={bx0} y={by0} width={bx1 - bx0} height={by1 - by0} fill="#8a5d33" opacity="0.12" stroke="#8a5d33" stroke-width="1" />
      <polyline points={[[-26.204, 28.047], [-25.747, 28.188], [-24.884, 28.31], [-24.509, 28.735], [-24.194, 29.03], [-23.904, 29.468]].map(([a, b]) => ipt(a, b)).join(' ')} fill="none" stroke="#3d4a48" stroke-width="1.6" />
      {iTowns.map((t) => { const [x, y] = IP(t.lat, t.lon); return (<g><circle cx={x} cy={y} r="3.5" fill="#1b1d1c" /><text x={t.n === 'Polokwane' ? x - 8 : x + 9} y={y + 4} text-anchor={t.n === 'Polokwane' ? 'end' : 'start'} font-family="Source Sans 3, sans-serif" font-size="11.5" font-weight="600" fill="#1b1d1c" letter-spacing="1">{t.n.toUpperCase()}</text></g>); })}
      <text x={I.x + 14} y={I.y + I.h - 14} font-family="Source Sans 3, sans-serif" font-size="11" fill="#5c625e" letter-spacing="1">250 KM FROM JOHANNESBURG ON THE N1</text>
    </g>
  </svg>
</figure>
