---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Thaba Ya Metsi" description="This page is not on the reserve’s site." noindex>
  <section class="page-head" style="border:0;min-height:70vh">
    <div class="wrap stack">
      <span class="eyebrow">404</span>
      <h1>This path does not lead anywhere.</h1>
      <p class="lede measure">The page may have moved. The reserve’s pages start from the home page.</p>
      <p><a class="btn" href="/">Back to the reserve <span class="arrow" aria-hidden="true">→</span></a></p>
    </div>
  </section>
</Base>
